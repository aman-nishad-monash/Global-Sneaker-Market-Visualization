{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 440,
  "data": {
    "url": "data/resale_cohort.csv",
    "format": {"type": "csv", "parse": {"release_year": "number", "sale_year": "number", "median_premium": "number", "n_models": "number"}}
  },
  "transform": [
    {"calculate": "datum.release_year == 2007 ? '2007 or earlier' : '' + datum.release_year", "as": "release_label"},
    {"calculate": "datum.sale_year == 2020 ? '2020 (Jan to Jul)' : '' + datum.sale_year", "as": "sale_label"},
    {"calculate": "datum.median_premium >= 0 ? format(datum.median_premium, '.0%') + ' above retail' : format(-datum.median_premium, '.0%') + ' below retail'", "as": "premium_text"},
    {"calculate": "datum.sale_year - datum.release_year", "as": "age"}
  ],
  "encoding": {
    "x": {
      "field": "sale_year", "type": "ordinal", "title": "Year resold",
      "axis": {"orient": "top", "labelAngle": 0, "labelFontSize": 12, "domain": false, "ticks": false,
               "labelExpr": "datum.value == 2020 ? '2020*' : datum.value", "titleColor": "#5C5A73", "titleFontWeight": 500}
    },
    "y": {
      "field": "release_year", "type": "ordinal", "title": "Year released", "sort": "descending",
      "axis": {"labelFontSize": 12, "domain": false, "ticks": false,
               "labelExpr": "datum.value == 2007 ? '≤2007' : datum.value", "titleColor": "#5C5A73", "titleFontWeight": 500}
    },
    "tooltip": [
      {"field": "release_label", "title": "Released"},
      {"field": "sale_label", "title": "Resold in"},
      {"field": "premium_text", "title": "Typical resale price"},
      {"field": "n_models", "type": "quantitative", "title": "Models with prices", "format": ","}
    ]
  },
  "layer": [
    {
      "mark": {"type": "rect", "stroke": "white", "strokeWidth": 2, "cornerRadius": 2},
      "encoding": {
        "color": {
          "field": "median_premium", "type": "quantitative",
          "scale": {"domain": [-0.5, 1.5], "domainMid": 0, "clamp": true, "range": ["#5B2A86", "#FFF6E5", "#D13A00"], "interpolate": "lab"},
          "legend": {
            "title": "Typical resale price vs retail", "orient": "bottom", "direction": "horizontal",
            "gradientLength": 300, "values": [-0.5, 0, 0.5, 1, 1.5],
            "labelExpr": "datum.value == 0 ? 'Retail' : datum.value <= -0.5 ? '−50% or less' : datum.value >= 1.5 ? '+150% or more' : format(datum.value, '+.0%')"
          }
        }
      }
    },
    {
      "mark": {"type": "text", "fontSize": 12, "fontWeight": 500},
      "encoding": {
        "text": {"field": "median_premium", "format": "+.0%"},
        "color": {"condition": {"test": "datum.median_premium > 0.7 || datum.median_premium < -0.3", "value": "white"}, "value": "#15131F"}
      }
    },
    {
      "description": "Callout: outline the peak square and explain it in the empty corner",
      "transform": [{"filter": "datum.release_year == 2009 && datum.sale_year == 2016"}],
      "mark": {"type": "rect", "fill": null, "stroke": "#15131F", "strokeWidth": 2.5, "cornerRadius": 2}
    },
    {
      "data": {"values": [{"sale_year": 2012, "release_year": 2017, "t": ["Peak: 2009 releases resold", "at +168% in 2016 (outlined)"]}]},
      "transform": [],
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": -10, "fontSize": 12, "fontWeight": 700, "lineHeight": 15, "color": "#D13A00"},
      "encoding": {"text": {"field": "t"}, "tooltip": null}
    }
  ],
  "config": {
    "font": "DM Sans, 'Helvetica Neue', Arial, sans-serif",
    "view": {"stroke": null},
    "axis": {"labelColor": "#15131F"},
    "legend": {"titleFontWeight": 500, "titleColor": "#5C5A73", "labelColor": "#15131F"}
  }
}
