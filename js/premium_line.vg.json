{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "data": {
    "url": "data/resale_quarterly.csv",
    "format": {"type": "csv", "parse": {"median_premium": "number", "n_models": "number"}}
  },
  "transform": [
    {"filter": "datum.grp != 'All models'"},
    {"calculate": "toNumber(substring(datum.quarter_sold, 0, 4))", "as": "year"},
    {"calculate": "toNumber(substring(datum.quarter_sold, 5, 6))", "as": "q"},
    {"calculate": "datetime(datum.year, (datum.q - 1) * 3 + 1, 15)", "as": "date"},
    {"calculate": "datum.quarter_sold == '2020Q3' ? 'July 2020 only' : datum.year + ' Q' + datum.q", "as": "period"},
    {"calculate": "datum.median_premium >= 0 ? format(datum.median_premium, '.0%') + ' above retail' : format(-datum.median_premium, '.0%') + ' below retail'", "as": "premium_text"}
  ],
  "encoding": {
    "x": {
      "field": "date", "type": "temporal", "title": null,
      "axis": {"format": "%Y", "tickCount": "year", "grid": false, "labelFontSize": 12}
    },
    "y": {
      "field": "median_premium", "type": "quantitative", "title": null,
      "axis": {"format": "+.0%", "labelExpr": "datum.value == 0 ? 'Retail price' : format(datum.value, '+.0%')"}
    },
    "color": {
      "field": "grp", "type": "nominal", "legend": null,
      "scale": {"domain": ["Collaboration", "Not a collaboration"], "range": ["#0F766E", "#45425E"]}
    }
  },
  "layer": [
    {
      "mark": {"type": "rule", "color": "#9C9AB5", "strokeWidth": 1, "strokeDash": [4, 3]},
      "encoding": {"y": {"datum": 0}, "x": null, "color": null}
    },
    {
      "transform": [{"filter": "datum.quarter_sold != '2020Q3'"}],
      "mark": {"type": "line", "strokeWidth": 3, "interpolate": "monotone"}
    },
    {
      "params": [{"name": "hover", "select": {"type": "point", "on": "pointerover", "nearest": true, "clear": "pointerout", "encodings": ["x"]}}],
      "mark": {"type": "point", "filled": true, "size": 40},
      "encoding": {
        "opacity": {"condition": {"param": "hover", "empty": false, "value": 1}, "value": 0},
        "tooltip": [
          {"field": "period", "title": "Period"},
          {"field": "grp", "title": "Group"},
          {"field": "premium_text", "title": "Typical resale price"},
          {"field": "n_models", "type": "quantitative", "title": "Models with prices", "format": ","}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.quarter_sold == '2020Q3'"}],
      "mark": {"type": "point", "filled": false, "size": 60, "strokeWidth": 2}
    },
    {
      "transform": [{"filter": "datum.quarter_sold == '2020Q3'"}],
      "mark": {"type": "text", "align": "left", "dx": 12, "fontSize": 13, "fontWeight": 700},
      "encoding": {"text": {"field": "grp"}}
    },
    {
      "transform": [{"filter": "datum.quarter_sold == '2020Q3'"}, {"joinaggregate": [{"op": "max", "field": "median_premium", "as": "top"}]}, {"filter": "datum.median_premium == datum.top"}],
      "mark": {"type": "text", "dy": -16, "fontSize": 11, "color": "#5C5A73", "text": "July 2020 only"},
      "encoding": {"color": null}
    },
    {
      "description": "Callouts: the 2013 collaboration peak, and 2018 when ordinary shoes fell below retail (dates match the quarter dates above)",
      "data": {"values": [
        {"yr": 2013, "mo": 1, "y": 1.40, "y_text": 1.40, "t": ["  2013 peak: collaborations resold", "  at more than double retail (+140%)"]},
        {"yr": 2018, "mo": 4, "y": -0.0417, "y_text": -0.08, "t": ["2018: ordinary shoes", "fall below retail"]}
      ]},
      "transform": [{"calculate": "datetime(datum.yr, datum.mo, 15)", "as": "note_date"}],
      "encoding": {"x": {"field": "note_date", "type": "temporal"}, "color": null},
      "layer": [
        {
          "transform": [{"filter": "datum.yr == 2018"}],
          "mark": {"type": "rule", "color": "#2B2850", "strokeWidth": 0.8},
          "encoding": {"y": {"field": "y", "type": "quantitative"}, "y2": {"field": "y_text"}}
        },
        {
          "transform": [{"filter": "datum.yr == 2013"}],
          "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 12, "fontSize": 12, "fontWeight": 700, "lineHeight": 15, "color": "#0F766E"},
          "encoding": {"y": {"field": "y_text", "type": "quantitative"}, "text": {"field": "t"}}
        },
        {
          "transform": [{"filter": "datum.yr == 2018"}],
          "mark": {"type": "text", "align": "right", "baseline": "middle", "dx": -6, "fontSize": 12, "fontWeight": 700, "lineHeight": 15, "color": "#2B2850"},
          "encoding": {"y": {"field": "y_text", "type": "quantitative"}, "text": {"field": "t"}}
        }
      ]
    }
  ],
  "config": {
    "font": "DM Sans, 'Helvetica Neue', Arial, sans-serif",
    "view": {"stroke": null},
    "padding": {"left": 5, "right": 10, "top": 10, "bottom": 5},
    "axis": {"labelColor": "#15131F", "domainColor": "#D3D0E4", "tickColor": "#D3D0E4", "gridColor": "#ECEAF6"}
  }
}
